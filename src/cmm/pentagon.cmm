// compiler used: https://github.com/KolibriOS/cminusminus

?include "write.h--"



word get_ticks() {
    $push BX

    $mov AH, 0x00
    $int 0x1A

    AX = DX;

    $pop BX

    return AX;
}

word xorshift(word s) {
    AX = s;

    DX = AX;
    $shl AX, 7
    $xor AX, DX

    DX = AX;
    $shr AX, 9
    $xor AX, DX

    DX = AX;
    $shl AX, 8
    $xor AX, DX

    return AX;
}

word random_range(word* seed, word lo, word hi) {
    word range;

    range = hi - lo + 1;

    AX = xorshift(*seed);
    *seed = AX;

    DX = 0;
    BX = range;
    $div BX

    return lo + DX;
}

void sleep(word seconds) {
    word start;
    word count;

    start = get_ticks();
    count = seconds * 18;

    while (get_ticks() - start < count) {}
}


main() {
    word seed;
    word progress;
    word limit;
    word roll;

    seed = get_ticks();

    if (seed == 0) {
        seed = 1;
    }

    progress = 0;

    while (progress < 100) {
        limit = progress + 20;

        if (limit > 100) {
            limit = 100;
        }

        progress = random_range(#seed, progress + 1, limit);

        WriteStr("Pentagon hack progress: ");
        WriteInt(progress);
        WriteStr("%\n");

        sleep(1);
    }

    roll = random_range(#seed, 1, 30);

    if (roll > 20) {
        WriteStr("Pentagon hack: Completed successfully.\n");

    } else {
        WriteStr("Pentagon hack: Failed.\n");
    }
}
